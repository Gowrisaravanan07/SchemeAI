# SchemeWise AI - Environment Variables Configuration

# 1. Gemini / Google GenAI LLM API Key (Optional: system provides deterministic fallback)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Supabase / PostgreSQL Database Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_or_anon_key

# 3. n8n Automation Webhook
N8N_WEBHOOK_URL=http://localhost:5678/webhook/schemewise-application
N8N_API_KEY=

# 4. Service Ports
PORT=8000
VITE_API_URL=http://localhost:8000
